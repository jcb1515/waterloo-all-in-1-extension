{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["extension/src/**/*.js", "extension/src/**/*.jsx"]
}
