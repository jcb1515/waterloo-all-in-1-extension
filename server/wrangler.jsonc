{
  "name": "waterloo-all-in-1-feed",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-27",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waterloo-all-in-1-feed",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
